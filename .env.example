# Application
API_PORT=5100
DEV_MODE=true
LOG_LEVEL=DEBUG

# PostgreSQL
POSTGRES_USER=qf
POSTGRES_PASSWORD=qf
POSTGRES_DB=qsint_rag
POSTGRES_PORT=5432
DATABASE_URL=postgresql://qf:qf@localhost:5432/qsint_rag

# Elasticsearch
ES_HOST=http://localhost:9200
ES_INDEX=qsint_docs
ES_PORT=9200
# ES_USER=
# ES_PASSWORD=

# Datasource: "es" (Elasticsearch) or "file" (local corpus file)
DATASOURCE_TYPE=es
FILE_DATASOURCE_PATH=./data/corpus.jsonl

# LLM — SGLang (OpenAI-compatible API, faster than Ollama for Qwen)
# Model is a HuggingFace model ID; SGLang downloads it on first start.
LLM_BASE_URL=http://localhost:30000/v1
LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=120
LLM_CONTEXT_LENGTH=32768
LLM_PARALLEL=10

# RAG retrieval
RAG_TOP_K=50
RAG_MAX_CONTEXT_CHUNKS=10
RAG_RELATIVE_THRESHOLD=0.35

# Insights
INSIGHTS_CACHE_TTL=1800
INSIGHTS_MAX_DOCS=2000

# Tracing (Jaeger via OTLP)
ENABLE_TRACING=false
QSINT_OTLP_ENDPOINT=http://localhost:4317

# Ports for docker-compose
SGLANG_PORT=30000
OLLAMA_PORT=11434      # only used by docker-compose-ollama.yml
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
FRONTEND_PORT=5173

# SGLang tuning (optional overrides)
SGLANG_MEM_FRACTION=0.85
# HF_TOKEN=hf_xxx    # needed for gated models (Llama, Mistral, etc.)

# Embeddings — fastembed (CPU-only, GPU stays owned by SGLang)
EMBED_MODEL=BAAI/bge-large-en-v1.5
EMBED_CACHE_DIR=./data/embed_cache
EMBED_DIMS=1024
EMBED_BATCH_SIZE=64
