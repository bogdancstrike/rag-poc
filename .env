# Application
API_PORT=5100
DEV_MODE=true
LOG_LEVEL=DEBUG

# PostgreSQL
POSTGRES_USER=qf
POSTGRES_PASSWORD=qf
POSTGRES_DB=qsint_rag
POSTGRES_PORT=5432
DATABASE_URL=postgresql://qf:qf@localhost:5432/qsint_rag

# Elasticsearch
ES_HOST=http://localhost:9200
ES_INDEX=qsint_docs
ES_PORT=9200
# ES_USER=
# ES_PASSWORD=

# Datasource: "es" (Elasticsearch) or "file" (local corpus file)
DATASOURCE_TYPE=es
FILE_DATASOURCE_PATH=./data/corpus.jsonl

# LLM — Ollama (OpenAI-compatible API)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_MAX_TOKENS=32768
LLM_TEMPERATURE=0.3

# Intelligence Report — large context for whole-corpus analysis
# num_ctx controls Ollama's context window; 65536 = 64 k tokens
LLM_INSIGHTS_CTX=65536
LLM_INSIGHTS_MAX_TOKENS=65536
# chars/token estimate used to convert token budget → character budget
LLM_CHARS_PER_TOKEN=3.5
# chars reserved for prompt schema + output; the rest is filled with doc text
LLM_INSIGHTS_RESERVE_CHARS=10000

# RAG Chat retrieval
RAG_TOP_K=50
RAG_MAX_CONTEXT_CHUNKS=8
RAG_RELATIVE_THRESHOLD=0.35

# Insights — sample a large pool; budget-aware packing decides what actually fits
INSIGHTS_CACHE_TTL=1800
INSIGHTS_MAX_DOCS=2000

# Tracing (Jaeger via OTLP)
ENABLE_TRACING=true
QSINT_OTLP_ENDPOINT=http://localhost:4317

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_TOPIC_LLM_TASKS=qsint.rag.llm_tasks
KAFKA_TOPIC_FAST_TASKS=qsint.rag.fast_tasks
KAFKA_CONSUMER_GROUP=qsint-rag-worker

# LLM concurrency (1=sequential, N=up to N parallel LLM calls)
LLM_PARALLEL=4

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# pgAdmin
PGADMIN_DEFAULT_EMAIL=qf@qsint.com
PGADMIN_DEFAULT_PASSWORD=qf

# Kafka UI port (host)
KAFKA_UI_PORT=8090

# Kibana port
KIBANA_PORT=5601

# Ports for docker-compose
OLLAMA_PORT=11434
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
FRONTEND_PORT=5173
