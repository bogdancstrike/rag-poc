# Application
API_PORT=5100
DEV_MODE=true
LOG_LEVEL=DEBUG

# PostgreSQL
POSTGRES_USER=qf
POSTGRES_PASSWORD=qf
POSTGRES_DB=qsint_rag
POSTGRES_PORT=5432
DATABASE_URL=postgresql://qf:qf@localhost:5432/qsint_rag

# Elasticsearch
ES_HOST=http://localhost:9200
ES_INDEX=qsint_docs
ES_PORT=9200
# ES_USER=
# ES_PASSWORD=

# Datasource: "es" (Elasticsearch) or "file" (local corpus file)
DATASOURCE_TYPE=es
FILE_DATASOURCE_PATH=./data/corpus.jsonl

# LLM — vLLM (OpenAI-compatible API)
# vLLM is started via docker-compose-llm.yml. The base URL points at the vLLM
# server; on local dev it's localhost:8000, in production set this to the
# dedicated GPU server's hostname (e.g. http://gpu-box.lan:8000/v1).
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=Qwen/Qwen3-4B-AWQ
LLM_TEMPERATURE=0.1

# Context window — set at vLLM launch via --max-model-len.
# vLLM exposes this in GET /v1/models; LLMClient reads it automatically.
# Setting here overrides discovery (useful if vLLM isn't up at app start).
LLM_CONTEXT_LENGTH=14336
LLM_INSIGHTS_CTX=14336
LLM_CHAT_CTX=14336
LLM_INSIGHTS_MAX_TOKENS=1024
# Input token cap for insight prompts — keeps prefill fast on small models.
# 8500 tok ≈ 29 750 chars → ~22 docs packed per task → consistent 5-15 s.
LLM_INSIGHTS_INPUT_MAX_TOKENS=8500

# Timeout per LLM call — vLLM with AWQ is fast; 120s is a generous ceiling.
LLM_TIMEOUT=120

# RAG Chat retrieval
RAG_TOP_K=50
RAG_MAX_CONTEXT_CHUNKS=30
RAG_RELATIVE_THRESHOLD=0.35

# Insights — sample a large pool; budget-aware packing decides what actually fits
INSIGHTS_CACHE_TTL=1800
INSIGHTS_MAX_DOCS=2000

# Tracing (Jaeger via OTLP)
ENABLE_TRACING=true
QSINT_OTLP_ENDPOINT=http://localhost:4317

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_TOPIC_LLM_TASKS=qsint.rag.llm_tasks
KAFKA_TOPIC_FAST_TASKS=qsint.rag.fast_tasks
KAFKA_CONSUMER_GROUP=qsint-rag-worker

# LLM concurrency (1=sequential, N=up to N parallel LLM calls)
LLM_PARALLEL=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Ports for docker-compose
PGADMIN_DEFAULT_EMAIL=qf@qsint.com
PGADMIN_DEFAULT_PASSWORD=qf
KAFKA_UI_PORT=8090
KIBANA_PORT=5601
VLLM_PORT=8000
OLLAMA_PORT=11434
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
FRONTEND_PORT=5173

# vLLM tuning (used by docker-compose-llm.yml)
VLLM_MODEL=Qwen/Qwen3-4B-AWQ
VLLM_GPU_UTIL=0.50
VLLM_MAX_MODEL_LEN=14336
VLLM_MAX_NUM_SEQS=16
# HF_TOKEN=hf_xxx           # uncomment if the model repo requires auth

# Embeddings.
# When EMBED_BASE_URL is set, the app POSTs to a TEI (Text Embeddings
# Inference) GPU server — production path, runs alongside vLLM via
# docker-compose-llm.yml. Leave empty to use the in-process CPU fastembed
# fallback (test mode / offline / dev box without GPU).
EMBED_BASE_URL=http://localhost:8080
TEI_PORT=8080
TEI_MODEL=BAAI/bge-m3
EMBED_MODEL=BAAI/bge-m3
EMBED_CACHE_DIR=./data/embed_cache
EMBED_DIMS=1024
EMBED_BATCH_SIZE=64
EMBED_TEXT_TRUNCATE_CHARS=32000
