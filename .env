# Application
API_PORT=5100
DEV_MODE=true
LOG_LEVEL=DEBUG

# PostgreSQL
POSTGRES_USER=qf
POSTGRES_PASSWORD=qf
POSTGRES_DB=qsint_rag
POSTGRES_PORT=5432
DATABASE_URL=postgresql://qf:qf@localhost:5432/qsint_rag

# Elasticsearch
ES_HOST=http://localhost:9200
ES_INDEX=qsint_docs
ES_PORT=9200
# ES_USER=
# ES_PASSWORD=

# Datasource: "es" (Elasticsearch) or "file" (local corpus file)
DATASOURCE_TYPE=es
FILE_DATASOURCE_PATH=./data/corpus.jsonl

# LLM — Ollama (OpenAI-compatible API)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.5:9b
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3
RAG_TOP_K=500

# Insights
INSIGHTS_CACHE_TTL=1800
INSIGHTS_MAX_DOCS=40

# Tracing (Jaeger via OTLP)
ENABLE_TRACING=true
QSINT_OTLP_ENDPOINT=http://localhost:4317

# Ports for docker-compose
OLLAMA_PORT=11434
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
FRONTEND_PORT=5173
